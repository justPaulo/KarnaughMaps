# Keep only the files needed to build, run, and document this app.
/*
!/.gitignore
!/Info.plist
!/ARCHITECTURE.md
!/AppIcon.swift
!/KarnaughLogic.swift
!/KarnaughMapsApp.swift
!/README.md
!/build-app.sh
!/images/
!/images/unicode-hex-input.png

# Swift, Xcode, and app build output.
/.build/
/build/
/artifacts/
/DerivedData/
/.swiftpm/
*.xcuserstate
*.xccheckout
*.xcodeproj/
*.xcworkspace/

# macOS and editor clutter.
.DS_Store
._*
*.swp
*.swo
*~
